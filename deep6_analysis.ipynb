   "source": [
    "# Deep6 Patient Classification Analysis\n",
    "## Class Preparation, Feature Preparation, and Machine Learning Analysis"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 1. CLASS PREPARATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import zipfile\n",
    "import os\n",
    "from glob import glob"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Configurable paths ---\n",
    "included_file = '...' #ALL PATIENTS IN PROTOCOL\n",
    "excluded_zip = '...' #all excluded patients\n",
    "excluded_extract_path = '...'\n",
    "deepsix_included_file = '' #included by deep6\n",
    "#^^used this included file since it had the most patients"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 1: Load included patients ---\n",
    "included_df = pd.read_csv(included_file)\n",
    "included_df.columns = included_df.columns.str.upper()  # Normalize casing\n",
    "\n",
    "included_mrns = set(included_df['MRN'].dropna().astype(str))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 2: Load excluded patients from ZIP ---\n",
    "with zipfile.ZipFile(excluded_zip, 'r') as zip_ref: \n",
    "    zip_ref.extractall(excluded_extract_path)\n",
    "\n",
    "excluded_mrns = set()\n",
    "for file in glob(os.path.join(excluded_extract_path, '*.xlsx')):\n",
    "    try: \n",
    "       df = pd.read_excel(file, header = 1)\n",
    "       df.columns = [col.strip().upper() for col in df.columns]\n",
    "\n",
    "     if 'MRN' not in df.columns:\n",
    "          print(f\" MRN column missing in {file}\")\n",
    "          continue\n",
    "       excluded_mrns.update(df['MRN'].dropna().astype(str))\n",
    "    except Exception as e:\n",
    "        print(f\"failed to process {file} : {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "deepsix_df = pd.read_csv(deepsix_included_file)\n",
    "deepsix_df.columns = deepsix_df.columns.str.upper()\n",
    "deepsix_mrns = set(deepsix_df['MRN'].dropna().astype(str).str.strip())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 3: Build labels ---\n",
    "records = []\n",
    "all_mrns = included_mrns.union(excluded_mrns)\n",
    "\n",
    "for mrn in all_mrns:\n",
    "    in_human = mrn in included_mrns\n",
    "    in_deepsix = mrn not in deepsix_mrns  # If not excluded, then included by DeepSix\n",
    "\n",
    "    if in_human and in_deepsix:\n",
    "        label = 0  # included by both\n",
    "    elif in_human and not in_deepsix:\n",
    "        label = 1  # included by human only\n",
    "    elif not in_human and in_deepsix:\n",
    "        label = 2  # included by Deep6 AI only\n",
    "  else:\n",
    "        continue  # excluded by both\n",
    "\n",
    "    records.append((mrn, label))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 4: Save to CSV ---\n",
    "labels_df = pd.DataFrame(records, columns=['MRN', 'label'])\n",
    "labels_df.to_csv('patient_class_labels.csv', index=False)\n",
    "print(\" Saved to patient_class_labels.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Step 5: Compare counts ---\n",
    "human_included = sum(labels_df['label'].isin([0, 1]))\n",
    "ai_included = sum(labels_df['label'].isin([0, 2]))\n",
    "\n",
    "print(f\"\\nHuman-included patients: {human_included}\")\n",
    "print(f\"DeepSix-included patients: {ai_included}\")\n",
    "print(\"\\nLabel breakdown:\")\n",
    "print(labels_df['label'].value_counts().rename({0: \"Both\", 1: \"Human only\", 2: \"AI only\"}))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Optional: Save excluded class 1 as .xlsx similar to included ---\n",
    "excluded_like_included = included_df[included_df['MRN'].astype(str).isin(\n",
    "    labels_df[labels_df['label'] == 1]['MRN']\n",
    ")]\n",
    "excluded_like_included.to_excel(\"curated_excluded_patients.xlsx\", index=False)\n",
    "\n",
    "# --- Optional: Clean up extracted folder ---\n",
    "import shutil\n",
    "shutil.rmtree(excluded_extract_path)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 2. FEATURE PREPARATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import os\n",
    "import zipfile\n",
    "from glob import glob"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Paths ---\n",
    "included_file = '...' #all patients on protocols\n",
    "excluded_zip = '...' #patients excluded by Deep6\n",
    "excluded_extract_path = '...'\n",
    "#all patients on protocols\n",
    "all_cancer_characteristics_path = '...' \n",
    "all_patient_demographics_path = '...'\n",
    "#included by deep6 \n",
    "cancer_characteristics_path_included_by_deepsix = '...' #ONLY deep6\n",
    "included_patient_demographics_deepsix = '...' #ONLY deep6 demographics\n",
    "labels_path = 'patient_class_labels.csv'\n",
    "#excluded by deep6 \n",
    "cancer_characteristics_path_excluded_by_deepsix = '...'\n",
    "excluded_patient_demographics_deepsix = '...' "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Expected columns\n",
    "expected_columns = [\n",
    "    'MRN', 'SEX', 'RACE', 'ETHNICITY', 'PROTOCOL_NUM', \n",
    "    'TUMOR_BEHAVIOR_DESC', 'HISTOLOGY_DESC', 'PATHOLOGICAL_TUMOR_SIZE_UNIT'\n",
    "]\n",
    "\n",
    "# Helper function to load and normalize CSV\n",
    "def load_csv(path):\n",
    "    \"\"\"Load CSV with consistent formatting\"\"\"\n",
    "    try:\n",
    "        df = pd.read_csv(path)\n",
    "        df.columns = df.columns.str.strip().str.upper()\n",
    "        if 'MRN' in df.columns:\n",
    "            df['MRN'] = df['MRN'].astype(str).str.strip()\n",
    "        return df\n",
    "    except Exception as e:\n",
    "        print(f\"Error loading {path}: {e}\")\n",
    "        return pd.DataFrame()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load labels\n",
    "print(\"Loading labels...\")\n",
    "labels_df = pd.read_csv(labels_path)\n",
    "labels_df['MRN'] = labels_df['MRN'].astype(str).str.strip()\n",
    "print(f\"Labels loaded: {labels_df.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load demographics sources\n",
    "print(\"Loading demographics data...\")\n",
    "demographics_sources = [\n",
    "    included_file,\n",
    "    all_patient_demographics_path,\n",
    "    included_patient_demographics_deepsix,\n",
    "    excluded_patient_demographics_deepsix,\n",
    "]\n",
    "\n",
    "demo_frames = []\n",
    "for path in demographics_sources:\n",
    "    df = load_csv(path)\n",
    "    if not df.empty:\n",
    "        demo_frames.append(df)\n",
    "\n",
    "if demo_frames:\n",
    "    demo_df = pd.concat(demo_frames, ignore_index=True).drop_duplicates(subset='MRN')\n",
    "    # Normalize column names\n",
    "    demo_df = demo_df.rename(columns={\n",
    "        'GENDER_DESC': 'SEX',\n",
    "        'RACE_DESC': 'RACE',\n",
    "    })\n",
    "    print(f\"Demographics combined: {demo_df.shape}\")\n",
    "else:\n",
    "    demo_df = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load cancer characteristics\n",
    "print(\"Loading cancer characteristics data...\")\n",
    "cancer_char_sources = [\n",
    "    all_cancer_characteristics_path,\n",
    "    cancer_characteristics_path_included_by_deepsix,\n",
    "    cancer_characteristics_path_excluded_by_deepsix,\n",
    "]\n",
    "\n",
    "char_frames = []\n",
    "for path in cancer_char_sources:\n",
    "    df = load_csv(path)\n",
    "    if not df.empty:\n",
    "        char_frames.append(df)\n",
    "\n",
    "if char_frames:\n",
    "    char_df = pd.concat(char_frames, ignore_index=True).drop_duplicates(subset='MRN')\n",
    "    # Keep relevant columns only\n",
    "    char_df = char_df[char_df.columns.intersection(expected_columns)]\n",
    "    print(f\"Cancer characteristics combined: {char_df.shape}\")\n",
    "else:\n",
    "    char_df = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Merge demographics and cancer characteristics\n",
    "if not demo_df.empty and not char_df.empty:\n",
    "    features_df = pd.merge(demo_df, char_df, on='MRN', how='outer')\n",
    "elif not demo_df.empty:\n",
    "    features_df = demo_df\n",
    "elif not char_df.empty:\n",
    "    features_df = char_df\n",
    "else:\n",
    "    features_df = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract and process excluded Excel files\n",
    "print(\"Processing excluded Excel files...\")\n",
    "if os.path.exists(excluded_zip):\n",
    "    # Create extraction directory\n",
    "    os.makedirs(excluded_extract_path, exist_ok=True)\n",
    "    \n",
    "    with zipfile.ZipFile(excluded_zip, 'r') as zip_ref:\n",
    "        zip_ref.extractall(excluded_extract_path)\n",
    "    \n",
    "    excluded_records = []\n",
    "    for file in glob(os.path.join(excluded_extract_path, '*.xlsx')):\n",
    "        try:\n",
    "            df = pd.read_excel(file, header=1)\n",
    "            df.columns = [col.strip().upper() for col in df.columns if col and str(col) != 'nan']\n",
    "            if 'MRN' in df.columns:\n",
    "                df['MRN'] = df['MRN'].astype(str).str.strip()\n",
    "                df = df.rename(columns={'GENDER_DESC': 'SEX', 'RACE_DESC': 'RACE'})\n",
    "                excluded_records.append(df)\n",
    "        except Exception as e:\n",
    "            print(f\"Error processing {file}: {e}\")\n",
    "    \n",
    "    # Merge excluded Excel data\n",
    "    if excluded_records:\n",
    "    excluded_df = pd.concat(excluded_records, ignore_index=True)\n",
    "        excluded_df = excluded_df[excluded_df.columns.intersection(expected_columns)]\n",
    "        if not features_df.empty:\n",
    "            features_df = pd.concat([features_df, excluded_df], ignore_index=True)\n",
    "        else:\n",
    "            features_df = excluded_df\n",
    "        print(f\"Excluded records added: {excluded_df.shape}\")\n",
    "    \n",
    "    # Cleanup extracted files\n",
    "    shutil.rmtree(excluded_extract_path, ignore_errors=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filter to expected columns and clean\n",
    "if not features_df.empty:\n",
    "    features_df = features_df[features_df.columns.intersection(expected_columns)]\n",
    "    features_df = features_df.drop_duplicates(subset='MRN')\n",
    "    features_df = features_df.fillna(\"Unknown\")\n",
    "    \n",
    "    # Merge with labels\n",
    "    final_df = pd.merge(labels_df, features_df, on='MRN', how='left')\n",
    "    # Ensure final column order\n",
    "    available_cols = [col for col in expected_columns if col in final_df.columns and col != 'MRN']\n",
    "    final_df = final_df[['MRN', 'label'] + available_cols]\n",
    "    \n",
    "    # Save cleaned dataset + remove MRN before saving dataset\n",
    "    final_df = final_df.drop(columns=['MRN'])
    "    final_df.to_csv('patient_features_filtered.csv', index=False)\n",
    "    print(f\"Saved cleaned feature file: patient_features_filtered.csv with shape {final_df.shape}\")\n",
    "else:\n",
    "    print(\"No feature data found, using only labels\")\n",
    "    final_df = labels_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. MACHINE LEARNING ANALYSIS — WITH UNKNOWNS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n=== MACHINE LEARNING ANALYSIS ===\")\n",
    "\n",
    "# Load the processed data\n",
    "if os.path.exists('patient_features_filtered.csv'):\n",
    "    df = pd.read_csv('patient_features_filtered.csv')\n",
    "else:\n",
    "    df = labels_df\n",
    "\n",
    "print(f\"Dataset shape: {df.shape}\")\n",
    "print(f\"Available columns: {list(df.columns)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check if we have features beyond MRN and label\n",
    "feature_columns = [col for col in df.columns if col not in ['MRN', 'label']]\n",
    "if not feature_columns:\n",
    "    print(\"No features found for machine learning analysis!\")\n",
    "    exit()\n",
    "\n",
    "# Prepare features and target\n",
    "X = df[feature_columns].copy()\n",
    "y = df['label'].copy()\n",
    "\n",
    "print(f\"Features shape: {X.shape}\")\n",
    "print(f\"Target distribution:\\n{y.value_counts()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define categorical and numeric columns based on actual data\n",
    "categorical_cols = []\n",
    "numeric_cols = []\n",
    "\n",
    "for col in X.columns:\n",
    "    # Check if column contains mostly numeric data\n",
    "    try:\n",
    "        numeric_values = pd.to_numeric(X[col], errors='coerce')\n",
    "        # If more than 50% of non-null values are numeric, treat as numeric\n",
    "        if numeric_values.notna().sum() / len(X[col].dropna()) > 0.5:\n",
    "            numeric_cols.append(col)\n",
    "        else:\n",
    "            categorical_cols.append(col)\n",
    "    except:\n",
    "        categorical_cols.append(col)\n",
    "\n",
    "print(f\"Categorical columns: {categorical_cols}\")\n",
    "print(f\"Numeric columns: {numeric_cols}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Process categorical features\n",
    "X_cat_processed = pd.DataFrame(index=X.index)\n",
    "if categorical_cols:\n",
    "    X_cat = X[categorical_cols].fillna('Unknown').astype(str)\n",
    "    # One-hot encode categorical variables\n",
    "    X_cat_encoded = pd.get_dummies(X_cat, drop_first=False, prefix_sep='_')\n",
    "    X_cat_processed = X_cat_encoded\n",
    "\n",
    "# Process numeric features\n",
    "X_num_processed = pd.DataFrame(index=X.index)\n",
    "if numeric_cols:\n",
    "    X_num = X[numeric_cols].apply(pd.to_numeric, errors='coerce')\n",
    "    # Impute missing values with mean\n",
    "    if not X_num.empty:\n",
    "        imputer = SimpleImputer(strategy='mean')\n",
    "        X_num_imputed = pd.DataFrame(\n",
    "            imputer.fit_transform(X_num), \n",
    "            columns=X_num.columns, \n",
    "            index=X.index\n",
    "        )\n",
    "        X_num_processed = X_num_imputed"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Combine all features\n",
    "if not X_cat_processed.empty and not X_num_processed.empty:\n",
    "    X_final = pd.concat([X_num_processed, X_cat_processed], axis=1)\n",
    "elif not X_cat_processed.empty:\n",
    "    X_final = X_cat_processed\n",
    "elif not X_num_processed.empty:\n",
    "    X_final = X_num_processed\n",
    "else:\n",
    "    print(\"No processable features found!\")\n",
    "    exit()\n",
    "print(f\"Final feature matrix shape: {X_final.shape}\")\n",
    "\n",
    "# Check for any remaining issues\n",
    "if X_final.isnull().any().any():\n",
    "    print(\"Warning: Still have null values, filling with 0\")\n",
    "    X_final = X_final.fillna(0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Scale features\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X_final)\n",
    "\n",
    "# Train-test split\n",
    "try:\n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        X_scaled, y, stratify=y, test_size=0.2, random_state=42\n",
    "    )\n",
    "    print(\"Using stratified split\")\n",
    "except ValueError as e:\n",
    "    print(f\"Stratified split failed ({e}), using random split instead\")\n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        X_scaled, y, test_size=0.2, random_state=42\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train Random Forest model\n",
    "print(\"Training Random Forest model...\")\n",
    "rf = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)\n",
    "rf.fit(X_train, y_train)\n",
    "\n",
    "# Make predictions\n",
    "y_pred = rf.predict(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- FEATURE IMPORTANCE ANALYSIS ---\n",
    "\n",
    "print(\"\\n=== FEATURE IMPORTANCE ANALYSIS ===\")\n",
    "\n",
    "# Gini importance\n",
    "gini_importance = rf.feature_importances_\n",
    "gini_df = pd.DataFrame({\n",
    "    'Feature': X_final.columns,\n",
    "    'Gini_Importance': gini_importance\n",
    "}).sort_values(by='Gini_Importance', ascending=False)\n",
    "\n",
    "print(\"Top 10 features by Gini importance:\")\n",
    "print(gini_df.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Permutation importance\n",
    "print(\"Calculating permutation importance...\")\n",
    "try:\n",
    "    perm_result = permutation_importance(\n",
    "        rf, X_test, y_test, n_repeats=10, random_state=42, n_jobs=-1\n",
    "    )\n",
    "    perm_df = pd.DataFrame({\n",
    "        'Feature': X_final.columns,\n",
    "        'Permutation_Importance_Mean': perm_result.importances_mean,\n",
    "        'Permutation_Importance_Std': perm_result.importances_std\n",
    "    }).sort_values(by='Permutation_Importance_Mean', ascending=False)\n",
    "    \n",
    "  print(\"Top 10 features by Permutation importance:\")\n",
    "    print(perm_df.head(10))\n",
    "    \n",
    "    permutation_success = True\n",
    "except Exception as e:\n",
    "    print(f\"Permutation importance calculation failed: {e}\")\n",
    "    permutation_success = False"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- VISUALIZATION ---\n",
    "\n",
    "print(\"\\n=== CREATING VISUALIZATIONS ===\")\n",
    "\n",
    "# Set up the plotting style\n",
    "plt.style.use('default')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "# Create feature importance plots\n",
    "if permutation_success:\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(16, 8))\n",
    "    \n",
    "    # Gini importance plot\n",
    "    top_gini = gini_df.head(15)\n",
    "    axes[0].barh(range(len(top_gini)), top_gini['Gini_Importance'])\n",
    "    axes[0].set_yticks(range(len(top_gini)))\n",
    "    axes[0].set_yticklabels(top_gini['Feature'], fontsize=10)\n",
    "    axes[0].set_xlabel('Gini Importance')\n",
    "    axes[0].set_title('Top 15 Features by Gini Importance')\n",
    "    axes[0].invert_yaxis()\n",
    "    \n",
